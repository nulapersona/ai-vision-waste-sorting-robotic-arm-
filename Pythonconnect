# AI Vision Waste Sorting Robot
# Sample Code
# ==============================

import cv2
from ultralytics import YOLO
import serial
import time

# -------------------------------
# Load YOLOv8 Model
# -------------------------------
model = YOLO("best.pt")          # Trained model

# -------------------------------
# Serial Communication
# -------------------------------
arduino = serial.Serial('COM3', 9600)
time.sleep(2)

# -------------------------------
# Open Webcam
# -------------------------------
cap = cv2.VideoCapture(0)

print("Waste Sorting Started...")

while True:

    ret, frame = cap.read()

    if not ret:
        break

    # Perform Detection
    results = model(frame)

    for result in results:

        boxes = result.boxes

        for box in boxes:

            class_id = int(box.cls[0])

            confidence = float(box.conf[0])

            label = model.names[class_id]

            if confidence > 0.70:

                # Bounding Box
                x1, y1, x2, y2 = map(int, box.xyxy[0])

                cv2.rectangle(frame,
                              (x1, y1),
                              (x2, y2),
                              (0,255,0),2)

                cv2.putText(frame,
                            f"{label} {confidence:.2f}",
                            (x1,y1-10),
                            cv2.FONT_HERSHEY_SIMPLEX,
                            0.6,
                            (255,0,0),
                            2)

                # Send Command
                if label == "plastic":
                    arduino.write(b'P')

                elif label == "metal":
                    arduino.write(b'M')

                elif label == "paper":
                    arduino.write(b'A')

                elif label == "glass":
                    arduino.write(b'G')

                elif label == "organic":
                    arduino.write(b'O')

    cv2.imshow("AI Waste Sorting", frame)

    if cv2.waitKey(1) == ord('q'):
        break

cap.release()
arduino.close()
cv2.destroyAllWindows()
